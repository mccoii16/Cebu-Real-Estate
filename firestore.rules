rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserDisabledOrDeleted() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['disabled', 'deleted'];
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'martiligando@gmail.com') ||
        (!isUserDisabledOrDeleted() && (
          request.auth.token.role == 'superadmin' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
        ))
      );
    }

    function isEditor() {
      return isSignedIn() && !isUserDisabledOrDeleted() && (
        request.auth.token.role == 'editor' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor')
      );
    }

    function isAgent() {
      return isSignedIn() && !isUserDisabledOrDeleted() && (
        request.auth.token.role == 'agent' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 150 &&
             data.role in ['superadmin', 'editor', 'agent', 'user'] &&
             data.status in ['active', 'disabled', 'deleted'];
    }

    // Validation for Building
    function isValidBuilding(data) {
      return data.buildingId is string && data.buildingId.size() <= 128 &&
             data.buildingName is string && data.buildingName.size() <= 128 &&
             data.location is string && data.location.size() <= 100 &&
             data.address is string && data.address.size() <= 250 &&
             data.description is string && data.description.size() <= 3000 &&
             data.buildingImages is list && data.buildingImages.size() <= 30 &&
             data.amenities is list && data.amenities.size() <= 50 &&
             (!('status' in data) || data.status in ['published', 'unpublished', 'archived']);
    }

    // Validation for Neighborhood & Area (locations collection)
    function isValidLocation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.tagline is string && data.tagline.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.image is string && data.image.size() <= 1000 &&
             (!('status' in data) || data.status in ['published', 'unpublished', 'archived']);
    }

    // Validation for Property
    function isValidProperty(data) {
      return data.propertyId is string && data.propertyId.size() <= 128 &&
             data.buildingId is string && data.buildingId.size() <= 128 &&
             data.buildingName is string && data.buildingName.size() <= 128 &&
             data.propertyTitle is string && data.propertyTitle.size() <= 150 &&
             data.location is string && data.location.size() <= 100 &&
             data.address is string && data.address.size() <= 250 &&
             data.propertyType in ['Condo', 'Penthouse', 'House & Lot', 'Commercial', 'Townhouse'] &&
             data.listingType in ['sale', 'rent'] &&
             data.price is number && data.price >= 0 &&
             data.bedrooms is number && data.bedrooms >= 0 &&
             data.bathrooms is number && data.bathrooms >= 0 &&
             data.floorArea is number && data.floorArea >= 0 &&
             data.description is string && data.description.size() <= 3000 &&
             data.amenities is list && data.amenities.size() <= 50 &&
             data.images is list && data.images.size() <= 30 &&
             data.featured is bool &&
             data.status in ['draft', 'pending', 'approved', 'rejected', 'archived'];
    }

    // Validation for Inquiry
    function isValidInquiry(data) {
      return data.inquiryId is string && data.inquiryId.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.propertyInterest is string && data.propertyInterest.size() <= 200;
    }

    // Validation for AuditLog
    function isValidAuditLog(data) {
      return data.logId is string && data.logId.size() <= 128 &&
             data.editorId is string && data.editorId.size() <= 128 &&
             data.editorEmail is string && data.editorEmail.size() <= 200 &&
             data.editorRole in ['editor', 'superadmin'] &&
             data.contentType in ['property', 'building', 'neighborhood'] &&
             data.contentId is string && data.contentId.size() <= 128 &&
             data.action in ['create', 'update', 'publish', 'unpublish', 'archive', 'restore', 'upload_photo'] &&
             data.changedFields is list && data.changedFields.size() <= 50 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Helper: Validate Editor update against approval bypass & ownership reassignment
    function isValidEditorPropertyUpdate() {
      return !incoming().diff(existing()).affectedKeys().hasAny([
        'propertyId',
        'agentId',
        'agentName',
        'featured',
        'createdAt',
        'approvedAt',
        'approvedBy',
        'rejectionReason',
        'hasPendingReview',
        'pendingChanges'
      ]) && (
        // Archiving an unarchived property preserves pre-archive status
        (existing().status != 'archived' &&
         incoming().status == 'archived' &&
         incoming().get('previousStatus', null) == existing().status) ||
        // Restoring an archived property returns strictly to previousStatus (cannot bypass into approved)
        (existing().status == 'archived' &&
         incoming().status == existing().get('previousStatus', 'draft') &&
         incoming().get('previousStatus', null) == null) ||
        // Submitting an Editor-managed draft to Super Admin approval queue
        (existing().status == 'draft' &&
         incoming().status == 'pending' &&
         incoming().get('previousStatus', null) == existing().get('previousStatus', null)) ||
        // Normal editorial content/SEO/gallery update preserving approval status
        (incoming().status == existing().status &&
         incoming().get('previousStatus', null) == existing().get('previousStatus', null))
      );
    }

    // Users Collection: Super Admin exclusive write access (users cannot self-assign roles)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Buildings collection: Super Admin & active Editors can create/update; only Super Admin can delete
    match /buildings/{buildingId} {
      allow get: if isValidId(buildingId);
      allow list: if true;
      allow create, update: if isValidId(buildingId) && isValidBuilding(incoming()) && (isAdmin() || isEditor());
      allow delete: if isAdmin();
    }

    // Properties collection
    match /properties/{propertyId} {
      // Public read ONLY for approved properties. Agents see their own, Super Admins & Editors see all.
      allow get: if isValidId(propertyId) && (
        resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.agentId == request.auth.uid || isAdmin() || isEditor()))
      );

      allow list: if resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.agentId == request.auth.uid || isAdmin() || isEditor()));

      allow create: if isValidId(propertyId) && isValidProperty(incoming()) && (
        isAdmin() ||
        (isEditor() &&
         incoming().status in ['draft', 'pending'] &&
         incoming().featured == false &&
         (!('approvedAt' in incoming()) || incoming().approvedAt == null) &&
         (!('approvedBy' in incoming()) || incoming().approvedBy == null)) ||
        (isAgent() && incoming().agentId == request.auth.uid && incoming().status in ['draft', 'pending'])
      );

      allow update: if isValidId(propertyId) && (
        isAdmin() ||
        (isEditor() && isValidProperty(incoming()) && isValidEditorPropertyUpdate()) ||
        (
          isAgent() &&
          resource.data.agentId == request.auth.uid &&
          incoming().agentId == resource.data.agentId &&
          (
            // When currently draft or rejected, agent can edit and optionally resubmit
            (resource.data.status in ['draft', 'rejected'] && isValidProperty(incoming()) && incoming().status in ['draft', 'pending']) ||
            // When already approved, agent submits changes for review without touching live approved status
            (resource.data.status == 'approved' && incoming().status == 'approved' && incoming().hasPendingReview == true)
          )
        )
      );

      // Editors cannot permanently delete properties
      allow delete: if isValidId(propertyId) && (
        isAdmin() ||
        (isAgent() && resource.data.agentId == request.auth.uid && resource.data.status == 'draft')
      );
    }

    // Inquiries collection: Super Admin only (Editors have zero access)
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Locations / Neighborhoods collection: Super Admin & active Editors can create/update; only Super Admin can delete
    match /locations/{locationId} {
      allow read: if true;
      allow create, update: if isValidId(locationId) && isValidLocation(incoming()) && (isAdmin() || isEditor());
      allow delete: if isAdmin();
    }

    // Website settings: Super Admin only (Editors cannot change site/payment/email settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Immutable Content Change Audit Logs
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isValidAuditLog(incoming()) && (
        isAdmin() ||
        (isEditor() && incoming().editorId == request.auth.uid && incoming().editorRole == 'editor')
      );
      allow update, delete: if false;
    }
  }
}
